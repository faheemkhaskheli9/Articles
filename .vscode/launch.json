      "console": "integratedTerminal"
    },
    {
      "name": "Legal RAG: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/examples/verifiable-legal-rag",
      "args": [
        "-q"
      ],
      "console": "integratedTerminal"
    },
