{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Reasoning Cache: Offline (seed and run)",
      "type": "debugpy",
      "request": "launch",
      "module": "reasoning_cache",
      "cwd": "${workspaceFolder}/examples/reasoning-cache",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/examples/reasoning-cache/src"
      },
      "args": [
        "--seed",
        "--request",
        "Calculate checkout total: subtotal $120, discount 10%, tax 8%, shipping $5."
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Reasoning Cache: LLM builder (API key required)",
      "type": "debugpy",
      "request": "launch",
      "module": "reasoning_cache",
      "cwd": "${workspaceFolder}/examples/reasoning-cache",
      "envFile": "${workspaceFolder}/examples/reasoning-cache/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/examples/reasoning-cache/src"
      },
      "args": [
        "--build",
        "--request",
        "Compute total: shipping $0, tax 8%, discount 15%, subtotal $200."
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Reasoning Cache: Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/examples/reasoning-cache",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/examples/reasoning-cache/src"
      },
      "args": [
        "-q",
        "tests"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Agent Reliability: Offline demonstration",
      "type": "debugpy",
      "request": "launch",
      "module": "agent_reliability",
      "cwd": "${workspaceFolder}/examples/agent-reliability",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/examples/agent-reliability/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Agent Reliability: JSON trace",
      "type": "debugpy",
      "request": "launch",
      "module": "agent_reliability",
      "args": [
        "--json"
      ],
      "cwd": "${workspaceFolder}/examples/agent-reliability",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/examples/agent-reliability/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Agent Reliability: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q",
        "tests"
      ],
      "cwd": "${workspaceFolder}/examples/agent-reliability",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/examples/agent-reliability/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Legal RAG: Ask (offline)",
      "type": "debugpy",
      "request": "launch",
      "module": "legal_rag",
      "cwd": "${workspaceFolder}/examples/verifiable-legal-rag",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/examples/verifiable-legal-rag/src"
      },
      "args": [
        "ask",
        "How long is the notice to vacate a landlord must serve?"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Legal RAG: Ask in Urdu (offline)",
      "type": "debugpy",
      "request": "launch",
      "module": "legal_rag",
      "cwd": "${workspaceFolder}/examples/verifiable-legal-rag",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/examples/verifiable-legal-rag/src"
      },
      "args": [
        "ask",
        "--json",
        "\u0633\u06cc\u06a9\u06cc\u0648\u0631\u0679\u06cc \u0688\u067e\u0627\u0632\u0679 \u06a9\u062a\u0646\u06d2 \u062f\u0646 \u0645\u06cc\u06ba \u0648\u0627\u067e\u0633 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u061f"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Legal RAG: Ask with LLM (.env required)",
      "type": "debugpy",
      "request": "launch",
      "module": "legal_rag",
      "cwd": "${workspaceFolder}/examples/verifiable-legal-rag",
      "envFile": "${workspaceFolder}/examples/verifiable-legal-rag/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/examples/verifiable-legal-rag/src"
      },
      "args": [
        "--generator",
        "openai",
        "ask",
        "--json",
        "Can a landlord cut off electricity to make a tenant leave?"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Legal RAG: Evaluate answer/abstain",
      "type": "debugpy",
      "request": "launch",
      "module": "legal_rag",
      "cwd": "${workspaceFolder}/examples/verifiable-legal-rag",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/examples/verifiable-legal-rag/src"
      },
      "args": [
        "evaluate"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Legal RAG: Threshold sweep",
      "type": "debugpy",
      "request": "launch",
      "module": "legal_rag",
      "cwd": "${workspaceFolder}/examples/verifiable-legal-rag",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/examples/verifiable-legal-rag/src"
      },
      "args": [
        "sweep"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Legal RAG: Verify adversarial drafts",
      "type": "debugpy",
      "request": "launch",
      "module": "legal_rag",
      "cwd": "${workspaceFolder}/examples/verifiable-legal-rag",
