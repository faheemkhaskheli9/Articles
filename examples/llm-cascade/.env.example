# Tier 2: a local model behind an OpenAI-compatible API.
# Ollama: install from https://ollama.com/download, then `ollama pull qwen2.5:7b`
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b
LOCAL_API_KEY=

# Tier 3: a paid model. Any OpenAI-compatible endpoint works.
REMOTE_BASE_URL=https://api.openai.com/v1
REMOTE_MODEL=gpt-4o-mini
REMOTE_API_KEY=

# SQLite cache for model answers (same prompt = no new call)
CASCADE_CACHE=.cache/llm_cascade.sqlite
