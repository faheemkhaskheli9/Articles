# Copy to .env only for the optional LLM command:
#   python -m tool_guard ask "C-310 se D-420 ko paanch hazar rupay bhejo."
# Every other command runs offline and needs no key.

# Any OpenAI-compatible Chat Completions server with tool calling.
# OpenAI:  https://api.openai.com/v1
# Ollama:  http://localhost:11434/v1   (API key can stay empty)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# A model that supports tool calling, e.g. a current OpenAI model name or an Ollama tag such as qwen2.5:7b
LLM_MODEL=
