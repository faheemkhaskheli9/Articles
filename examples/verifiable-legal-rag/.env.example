# Copy to .env only if you want the optional LLM generator:
#   python -m legal_rag --generator openai ask "..."
# The default extractive generator needs no key and no network.

# Any OpenAI-compatible Chat Completions server.
# OpenAI:  https://api.openai.com/v1
# Ollama:  http://localhost:11434/v1   (API key can stay empty)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# A model that supports JSON output, e.g. a current OpenAI model name or a local Ollama model tag.
LLM_MODEL=
